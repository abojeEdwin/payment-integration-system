# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# ============================================================================
# Copy this to .env and adjust values for your local machine.
# DO NOT commit .env to git.
#
# NETWORKING MODES:
# ┌─────────────────────────────────────────────────────────────────────┐
# │ IDE Mode: Services run locally on your machine                      │
# │   → All connection strings use localhost:PORT                       │
# │   → Docker containers are accessed via host port mappings           │
# │                                                                     │
# │ Docker Mode: Services run in containers                            │
# │   → Docker Compose overrides URLs with container DNS names         │
# │   → postgres:5432 (not localhost), kafka:29092 (not localhost)     │
# └─────────────────────────────────────────────────────────────────────┘
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# POSTGRES CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Docker host-side port mapping (adjust if 5432 is already in use)
# Example: if 5432 is busy, set to 5433 and use localhost:5433 in IDE
POSTGRES_HOST_PORT=5432

# Superuser credentials (only used by docker-compose to bootstrap DB)
POSTGRES_SUPERUSER_PASSWORD=postgres

# Shared password for all app roles: auth_user, payment_user, webhook_user
# Change this in production!
APP_DB_PASSWORD=dev_password_123

# ─────────────────────────────────────────────────────────────────────────
# AUTH-SERVICE DATABASE
# ─────────────────────────────────────────────────────────────────────────
# For IDE: localhost:5432 (Docker container port is mapped to host)
# For Docker: postgres:5432 (Docker Compose sets this automatically)
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=dev_password_123

# ─────────────────────────────────────────────────────────────────────────
# PAYMENT-SERVICE DATABASE
# ─────────────────────────────────────────────────────────────────────────
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=dev_password_123

# ─────────────────────────────────────────────────────────────────────────
# WEBHOOK-SERVICE DATABASE
# ─────────────────────────────────────────────────────────────────────────
WEBHOOK_DB_URL=jdbc:postgresql://localhost:5432/webhook_db
WEBHOOK_DB_USERNAME=webhook_user
WEBHOOK_DB_PASSWORD=dev_password_123

# ─────────────────────────────────────────────────────────────────────────
# KAFKA CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# For IDE: localhost:9092 (Kafka container port is mapped to host)
# For Docker: kafka:29092 (Docker Compose sets this automatically)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─────────────────────────────────────────────────────────────────────────
# SERVICE-TO-SERVICE NETWORKING
# ─────────────────────────────────────────────────────────────────────────
# For IDE: use localhost with service ports
# For Docker: Docker Compose overrides these with container DNS names
AUTH_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
WEBHOOK_SERVICE_URL=http://localhost:8083

# ─────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=07e7d120437153c0a2b2f9578d7cce771a0ac48315388e76d868c68e5be36c7f

# ─────────────────────────────────────────────────────────────────────────
# PAYMENT PROVIDER CREDENTIALS (test/sandbox keys)
# ─────────────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_DEFAULT
INTERSWITCH_SECRET_KEY=sk_test_xxx
SQUADCO_SECRET_KEY=sandbox_sk_default

# ─────────────────────────────────────────────────────────────────────────
# PAYMENT PROVIDER WEBHOOK SIGNATURES (leave empty during development)
# ─────────────────────────────────────────────────────────────────────────
PAYSTACK_WEBHOOK_SECRET=
INTERSWITCH_WEBHOOK_SECRET=
SQUADCO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# PGADMIN (Database Web UI)
# ─────────────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@paybridge.dev
PGADMIN_DEFAULT_PASSWORD=admin123

