# PostgreSQL
POSTGRES_PASSWORD=dev_password_123

# Vault
VAULT_DEV_ROOT_TOKEN=dev-only-token-123

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@paybridge.local
